# Local configuration. Existing process environment values take precedence.
HOST=127.0.0.1
PORT=3000

# Express uses NODE_ENV; set production in the deployment environment when needed.
NODE_ENV=development

# PostgreSQL 18 on this machine only; provision the database and roles separately.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=balamandian
PGUSER=balamandian_app
# Required: fill this only in your ignored .env, never in this template.
PGPASSWORD=

# Bounded local pool settings (all values must be positive decimal integers).
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Keep real secrets in ignored local files or the deployment secret manager.

# Required HTTPS origin; no path, query string, or embedded credentials.
SIS_BASE_URL=https://sis.example.edu
SIS_SERVICE_API_KEY=
SIS_TIMEOUT_MS=5000

# Required: generate 32 random bytes, hex encoded. Never reuse the SIS key.
OTP_SECRET=
# Fixed OTP policy: six digits, 10 minutes, 5 attempts, 60-second cooldown,
# 3 resends per 1-hour registration window (repeated registration shares the limit).
SESSION_LIFETIME_SECONDS=604800

# Required SMTP configuration; startup fails if incomplete. No console delivery mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# A single mailbox address, without a display name.
SMTP_FROM=
# Development-only loopback SMTP capture may use port 1025, secure=false,
# and empty SMTP_USER/SMTP_PASSWORD. Remote non-TLS connections require STARTTLS.

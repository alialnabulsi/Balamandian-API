{
  "name": "balamandian-api",
  "version": "0.1.0",
  "private": true,
  "description": "Main application backend for the Balamandian university mobile application.",
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "build": "tsc --project tsconfig.json",
    "db:migrate": "npm run build && node --env-file-if-exists=.env --enable-source-maps dist/scripts/migrate.js",
    "test": "npm run build && node --test test/*.test.js",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test test/integration/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "express": "5.3.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1"
  }
}
